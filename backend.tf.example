# Advanced / manual path — prefer: docker compose run --rm bootstrap
#
# 1. First apply with local state (no backend.tf in the tree).
# 2. cp backend.tf.in backend.tf
# 3. Write backend.hcl with bucket/key (see outputs tfstate_bucket, bootstrap_state_key).
# 4. Load AWS keys via Docker --env-file .backend-credentials (KEY=VALUE format).
# 5. terraform init -migrate-state -force-copy -backend-config=backend.hcl

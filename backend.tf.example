# After the first local-state apply creates the bucket, copy this file to backend.tf,
# fill bucket name from `terraform output -raw tfstate_bucket` (or backend_config_hint),
# load credentials (`source .backend-credentials`), then:
#   terraform init -migrate-state
#
# Prefer running via: docker run ... stupean/yandex-terraform init -migrate-state

terraform {
  backend "s3" {
    endpoints = {
      s3 = "https://storage.yandexcloud.net"
    }
    bucket = "REPLACE_WITH_tfstate_bucket_OUTPUT"
    region = "ru-central1"
    key    = "bootstrap/terraform.tfstate"

    skip_region_validation      = true
    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_s3_checksum            = true
  }
}

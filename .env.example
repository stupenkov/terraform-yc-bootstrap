# Copy to .env and fill in. Do not commit .env.
# Compose loads this file into the container; Terraform reads TF_VAR_* as input variables.

YC_TOKEN=
BOOTSTRAP_AUTO_APPROVE=1

# --- First create (Dev A) ---
# New cloud (set both):
TF_VAR_organization_id=
TF_VAR_billing_account_id=
# TF_VAR_cloud_name=main

# Or reuse an existing cloud when creating folders in it:
# TF_VAR_cloud_id=

# --- Join / second developer (Dev B) ---
# Happy path: YC_TOKEN only — discovery finds platform bucket with bootstrap/workspace.json
# If several workspaces exist, disambiguate:
# TFSTATE_BUCKET=tfstate-........
# Optional narrowing:
# TF_VAR_cloud_id=
# TF_VAR_organization_id=

# Optional: reuse existing AWS keys instead of minting a new static key for SA tfstate
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional overrides (defaults are fine for most setups):
# TF_VAR_zone=ru-central1-d
# TF_VAR_bucket_name_prefix=tfstate
# TF_VAR_bootstrap_state_key=bootstrap/terraform.tfstate
